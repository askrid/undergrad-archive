# Project-specific build outputs. Generic C/C++ object, library, shared-object
# and debug patterns live in the repo-root .gitignore.

# Executables (kept local so they don't mask binaries in other projects)
*.exe
*.out
*.app
*.i*86
*.x86_64

# MS object / linker map (collide with 3D models / source maps elsewhere)
*.obj
*.map

# Kernel Module Compile Results (kernellab)
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# malloclab driver binary
mdriver
